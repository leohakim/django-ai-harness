Screen {
    background: #0f1419;
    color: #e7ecf1;
}

Header {
    background: #1a2332;
    color: #e7ecf1;
    text-style: bold;
}

Footer {
    background: #1a2332;
}

#panel {
    padding: 1 2;
    width: 100%;
    height: 1fr;
}

#brand {
    text-style: bold;
    color: #7dd3fc;
    content-align: center middle;
    width: 100%;
    margin-top: 1;
}

#tagline {
    color: #94a3b8;
    content-align: center middle;
    width: 100%;
    margin-bottom: 1;
}

.step-title {
    text-style: bold;
    color: #7dd3fc;
    margin-bottom: 1;
}

#step_subtitle {
    color: #cbd5e1;
    margin-bottom: 1;
}

#choices {
    height: auto;
    max-height: 12;
    margin: 1 0;
    border: tall #334155;
    background: #111827;
}

.explain {
    margin: 1 0;
    padding: 1;
    background: #111827;
    border: tall #334155;
    height: auto;
    min-height: 8;
}

.error {
    color: #f87171;
    margin: 1 0;
}

.actions {
    height: auto;
    margin-top: 1;
    align: left middle;
}

Button {
    margin-right: 1;
}

Input {
    margin-bottom: 1;
    border: tall #334155;
}

#generate_panel {
    width: 90%;
    height: 80%;
    border: tall #334155;
    background: #0f1419;
    padding: 1 2;
}

#gen_log {
    height: 1fr;
    margin: 1 0;
    border: tall #334155;
}

Markdown {
    margin: 0 0 1 0;
}
